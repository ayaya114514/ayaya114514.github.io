---
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/CommonPage.astro'
import BlogDirectory from '@/components/blog/Directory.astro'
import { blogGroups, getBlogGroupKey } from '@/utils/blog-navigation'

type BlogGroup = (typeof blogGroups)[number]

interface Props {
  group: BlogGroup
  posts: CollectionEntry<'blog'>[]
}

export async function getStaticPaths() {
  const posts = await getBlogCollection()

  return blogGroups.map((group) => ({
    params: { group: group.slug },
    props: {
      group,
      posts: posts
        .filter((post) => getBlogGroupKey(post.id) === group.slug)
        .sort((a, b) => a.id.localeCompare(b.id))
    }
  }))
}

const { group, posts } = Astro.props
---

<PageLayout title={group.title} description={group.description}>
  <BlogDirectory posts={posts} group={group.slug} slot='sidebar' />

  <section class='note-catalog not-prose' aria-label={`${group.title}笔记目录`}>
    {
      posts.map((post) => (
        <a class='note-row' href={`/blog/${post.id}/`} data-astro-prefetch>
          <h2>{post.data.title}</h2>
        </a>
      ))
    }
  </section>
</PageLayout>

<style>
  .note-catalog {
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.65rem;
    background: hsl(var(--background) / 0.46);
  }

  .note-row {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .note-row + .note-row {
    border-top: 1px solid hsl(var(--border));
  }

  .note-row:hover {
    background: hsl(var(--muted) / 0.35);
  }

  .note-row h2 {
    margin: 0;
    padding: 0.85rem 1rem;
    overflow-wrap: anywhere;
    color: hsl(var(--foreground));
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.55;
    transition: color 150ms ease;
  }

  .note-row:hover h2 {
    color: hsl(var(--primary));
  }

  @media (max-width: 767px) {
    .note-row h2 {
      padding: 0.8rem 0.9rem;
    }
  }
</style>
