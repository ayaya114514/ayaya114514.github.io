---
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/CommonPage.astro'
import BlogGroupNav from '@/components/blog/GroupNav.astro'
import { blogGroups, getBlogGroupKey } from '@/utils/blog-navigation'

export const prerender = true

const posts = await getBlogCollection()
---

<PageLayout title='笔记' description='按主题浏览学习笔记、论文速读与其他技术记录。'>
  <BlogGroupNav slot='sidebar' />

  <section class='not-prose'>
    <div class='grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3'>
      {
        blogGroups.map((group) => {
          const postCount = posts.filter((post) => getBlogGroupKey(post.id) === group.slug).length

          return (
            <a
              href={`/blog/${group.slug}/`}
              class='group rounded-xl border bg-background/60 p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md'
              data-astro-prefetch
            >
              <h2 class='m-0 text-xl font-medium leading-snug group-hover:text-[var(--primary)]'>
                {group.title}
              </h2>
              <p class='mt-6 text-xs text-muted-foreground/80'>{postCount} 篇笔记</p>
            </a>
          )
        })
      }
    </div>
  </section>
</PageLayout>
