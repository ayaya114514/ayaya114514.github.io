---
import { getBlogLandingHref } from '@/utils/blog-navigation'

export const prerender = true

// 顶部和侧边导航会直接指向第一篇；此页仅作外部旧链接的 fallback。
const target = await getBlogLandingHref()
---

<!doctype html>
<html lang='zh-CN'>
  <head>
    <meta charset='utf-8' />
    <title>跳转中…</title>
    {/* 立即跳转：meta refresh 兜底（无 JS 时也生效），script 优先（不留下中间历史项） */}
    <meta http-equiv='refresh' content={`0;url=${target}`} />
    <link rel='canonical' href={target} />
    <meta name='robots' content='noindex' />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target)
    </script>
  </head>
  <body>
    <a href={target}>跳转到 {target}</a>
  </body>
</html>
