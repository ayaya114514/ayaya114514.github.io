---
import PageLayout from '@/layouts/CommonPage.astro'
import ArtistNav from '@/components/lyrics/ArtistNav.astro'

import { getArtistSongs, lyricArtists, songSlug } from '../../../data/lyrics'

type Props = {
  artistSlug: string
  songTitle: string
}

type JapaneseSegment = {
  text: string
  reading?: string
}

export function getStaticPaths() {
  return lyricArtists.flatMap((artist) =>
    getArtistSongs(artist).map((songTitle) => ({
      params: { artist: artist.slug, song: songSlug(songTitle) },
      props: { artistSlug: artist.slug, songTitle }
    }))
  )
}

function parseJapanese(value: string): JapaneseSegment[] {
  const segments: JapaneseSegment[] = []
  const annotation = /([\p{Script=Han}々〆ヵヶ￥]+)（([^（）]+)）/gu
  let cursor = 0

  for (const match of value.matchAll(annotation)) {
    const index = match.index ?? 0
    if (index > cursor) segments.push({ text: value.slice(cursor, index) })
    segments.push({ text: match[1], reading: match[2] })
    cursor = index + match[0].length
  }

  if (cursor < value.length) segments.push({ text: value.slice(cursor) })
  return segments
}

const { artistSlug, songTitle } = Astro.props as Props
const artist = lyricArtists.find((candidate) => candidate.slug === artistSlug)
if (!artist) throw new Error(`Unknown lyric artist: ${artistSlug}`)

const lines = artist.details[songTitle]?.lines ?? []
---

<PageLayout
  title={songTitle}
  description={`${artist.name}《${songTitle}》的日语与中文歌词。`}
  back={`/lyrics/${artist.slug}/`}
>
  <ArtistNav slot='sidebar' artists={lyricArtists} currentSlug={artist.slug} />

  {
    lines.length > 0 && (
      <ol class='lyric-sheet not-prose'>
        {lines.map((line) => (
          <li class:list={['lyric-block', line.breakBefore && 'stanza-break']}>
            <p lang='ja' class='lyric-japanese'>
              {parseJapanese(line.japanese).map((segment) =>
                segment.reading ? (
                  <ruby>
                    {segment.text}
                    <rt>{segment.reading}</rt>
                  </ruby>
                ) : (
                  segment.text
                )
              )}
            </p>
            {line.chinese && (
              <p lang='zh-CN' class='lyric-chinese'>
                {line.chinese}
              </p>
            )}
          </li>
        ))}
      </ol>
    )
  }
</PageLayout>

<style>
  .lyric-sheet {
    max-width: 52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lyric-block {
    margin: 0;
  }

  .lyric-block + .lyric-block {
    margin-top: clamp(1.45rem, 3vw, 1.9rem);
  }

  .lyric-block.stanza-break {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  .lyric-block p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .lyric-japanese {
    color: hsl(var(--foreground));
    font-size: clamp(1.35rem, 2.7vw, 1.75rem);
    font-weight: 480;
    line-height: 2;
    letter-spacing: 0.012em;
  }

  .lyric-japanese ruby {
    ruby-align: center;
    ruby-position: over;
  }

  .lyric-japanese rt {
    color: hsl(var(--foreground) / 0.82);
    font-size: 0.48em;
    font-weight: 450;
    letter-spacing: 0.03em;
  }

  .lyric-chinese {
    margin-top: 0.3rem !important;
    color: hsl(var(--foreground) / 0.78);
    font-size: clamp(1.08rem, 2.2vw, 1.3rem);
    line-height: 1.75;
    letter-spacing: 0.008em;
  }

  @media (max-width: 639px) {
    .lyric-block + .lyric-block {
      margin-top: 1.35rem;
    }

    .lyric-block.stanza-break {
      margin-top: 2.8rem;
    }
  }
</style>
