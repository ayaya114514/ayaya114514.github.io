---
import PageLayout from '@/layouts/CommonPage.astro'
import ArtistNav from '@/components/lyrics/ArtistNav.astro'

import { getArtistLyricSongs, lyricArtists, songSlug, type LyricLine } from '../../../data/lyrics'

type Props = {
  artistSlug: string
  songTitle: string
}

type JapaneseSegment = {
  text: string
  reading?: string
}

export function getStaticPaths() {
  return lyricArtists.flatMap((artist) =>
    getArtistLyricSongs(artist).map((songTitle) => ({
      params: { artist: artist.slug, song: songSlug(songTitle) },
      props: { artistSlug: artist.slug, songTitle }
    }))
  )
}

function parseJapanese(value: string): JapaneseSegment[] {
  const segments: JapaneseSegment[] = []
  const annotation = /([\p{Script=Han}々〆ヵヶ]+)[（(]([ぁ-んァ-ヿー々〆ヵヶ]{1,12})[）)]/gu
  let cursor = 0

  for (const match of value.matchAll(annotation)) {
    const index = match.index ?? 0
    if (index > cursor) segments.push({ text: value.slice(cursor, index) })
    segments.push({ text: match[1], reading: match[2] })
    cursor = index + match[0].length
  }

  if (cursor < value.length) segments.push({ text: value.slice(cursor) })
  return segments
}

function groupStanzas(lyricLines: LyricLine[]): LyricLine[][] {
  const stanzas: LyricLine[][] = []

  for (const line of lyricLines) {
    if (stanzas.length === 0 || line.breakBefore) stanzas.push([])
    stanzas[stanzas.length - 1].push(line)
  }

  return stanzas
}

const { artistSlug, songTitle } = Astro.props as Props
const artist = lyricArtists.find((candidate) => candidate.slug === artistSlug)
if (!artist) throw new Error(`Unknown lyric artist: ${artistSlug}`)

const lines = artist.details[songTitle]?.lines ?? []
const titleTranslation = artist.titleTranslations[songTitle]
if (!titleTranslation)
  throw new Error(`Missing lyric title translation: ${artistSlug}/${songTitle}`)

const stanzas = groupStanzas(lines)
const pageTitle = `${songTitle}（${titleTranslation}）`
---

<PageLayout
  title={pageTitle}
  description={`${artist.name}《${pageTitle}》的日语与中文歌词。`}
  back={`/lyrics/${artist.slug}/`}
>
  <ArtistNav slot='sidebar' artists={lyricArtists} currentSlug={artist.slug} />

  {
    stanzas.length > 0 && (
      <div class='lyric-sheet not-prose'>
        {stanzas.map((stanza) => (
          <section class='lyric-stanza'>
            <ol class='lyric-lines'>
              {stanza.map((line) => (
                <li class='lyric-row'>
                  <p lang='ja' class='lyric-japanese'>
                    {parseJapanese(line.japanese).map((segment) =>
                      segment.reading ? (
                        <ruby>
                          {segment.text}
                          <rt>{segment.reading}</rt>
                        </ruby>
                      ) : (
                        segment.text
                      )
                    )}
                  </p>
                  <p lang='zh-CN' class='lyric-chinese'>
                    {line.chinese ?? ''}
                  </p>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    )
  }
</PageLayout>

<style>
  .lyric-sheet {
    width: 100%;
    max-width: 72rem;
    margin: 0;
  }

  .lyric-stanza {
    position: relative;
  }

  .lyric-stanza::after {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: 1px;
    background: hsl(var(--border) / 0.6);
    content: '';
    pointer-events: none;
  }

  .lyric-stanza + .lyric-stanza {
    margin-top: clamp(0.9rem, 2vw, 1.25rem);
    padding-top: clamp(0.9rem, 2vw, 1.25rem);
    border-top: 1px solid hsl(var(--border) / 0.6);
  }

  .lyric-lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lyric-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    margin: 0;
  }

  .lyric-row + .lyric-row {
    margin-top: clamp(0.55rem, 1.4vw, 0.9rem);
  }

  .lyric-row p {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .lyric-japanese {
    padding-inline-end: clamp(1.25rem, 3.5vw, 3rem);
    color: hsl(var(--foreground));
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 480;
    line-height: 2.1;
    letter-spacing: 0.012em;
  }

  .lyric-japanese ruby {
    ruby-align: center;
    ruby-position: over;
  }

  .lyric-japanese rt {
    color: hsl(var(--foreground) / 0.82);
    font-size: 0.48em;
    font-weight: 450;
    letter-spacing: 0.03em;
  }

  .lyric-chinese {
    padding-block-start: 0.2em;
    padding-inline-start: clamp(1.25rem, 3.5vw, 3rem);
    color: hsl(var(--foreground) / 0.78);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.9;
    letter-spacing: 0.008em;
  }

  @media (max-width: 639px) {
    .lyric-stanza + .lyric-stanza {
      margin-top: 0.9rem;
      padding-top: 0.9rem;
    }

    .lyric-row + .lyric-row {
      margin-top: 0.65rem;
    }

    .lyric-japanese {
      padding-inline-end: 0.8rem;
      font-size: 1rem;
      line-height: 2.15;
    }

    .lyric-chinese {
      padding-block-start: 0.28em;
      padding-inline-start: 0.8rem;
      font-size: 0.92rem;
      line-height: 1.85;
    }
  }
</style>
