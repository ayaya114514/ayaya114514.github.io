---
import PageLayout from '@/layouts/CommonPage.astro'

import { getArtistSongs, getSongReleases, lyricArtists, songSlug } from '../../../data/lyrics'

type Props = {
  artistSlug: string
  songTitle: string
}

export function getStaticPaths() {
  return lyricArtists.flatMap((artist) =>
    getArtistSongs(artist).map((songTitle) => ({
      params: { artist: artist.slug, song: songSlug(songTitle) },
      props: { artistSlug: artist.slug, songTitle }
    }))
  )
}

const { artistSlug, songTitle } = Astro.props as Props
const artist = lyricArtists.find((candidate) => candidate.slug === artistSlug)
if (!artist) throw new Error(`Unknown lyric artist: ${artistSlug}`)

const details = artist.details[songTitle] ?? {}
const releases = getSongReleases(artist, songTitle)
---

<PageLayout
  title={songTitle}
  description={`${artist.name}《${songTitle}》的日语、罗马音与中文歌词页面。`}
  back={`/lyrics/${artist.slug}/`}
>
  <div class='not-prose'>
    <nav
      class='mb-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground'
      aria-label='面包屑'
    >
      <a href='/lyrics/'>歌词</a>
      <span aria-hidden='true'>/</span>
      <a href={`/lyrics/${artist.slug}/`}>{artist.name}</a>
      <span aria-hidden='true'>/</span>
      <span class='text-foreground'>{songTitle}</span>
    </nav>

    <div class='mb-10 border-y py-4'>
      <p class='text-sm text-muted-foreground'>艺人</p>
      <p class='mt-1 text-base text-foreground'>{artist.name}</p>
      <p class='mt-4 text-sm text-muted-foreground'>分类</p>
      <p class='mt-1 text-sm leading-6 text-foreground'>{releases.join(' · ')}</p>
    </div>

    {
      details.lines?.length ? (
        <section aria-labelledby='lyrics-heading'>
          <div class='mb-8'>
            <h2 id='lyrics-heading' class='m-0 text-lg font-medium text-foreground'>
              歌词
            </h2>
            {details.note && (
              <p class='mt-2 text-sm leading-6 text-muted-foreground'>{details.note}</p>
            )}
          </div>

          <ol class='lyric-sheet m-0 list-none p-0'>
            {details.lines.map((line) => (
              <li class='lyric-block m-0'>
                <p lang='ja' class='lyric-japanese'>
                  {line.japanese}
                </p>
                <p lang='ja-Latn' class='lyric-romaji'>
                  {line.romaji}
                </p>
                <p lang='zh-CN' class='lyric-chinese'>
                  {line.chinese}
                </p>
              </li>
            ))}
          </ol>
        </section>
      ) : (
        <section class='rounded-xl border border-dashed bg-background/35 px-5 py-8 sm:px-7'>
          <h2 class='m-0 text-base font-medium text-foreground'>歌词正文尚未收录</h2>
          <p class='mt-2 max-w-2xl text-sm leading-7 text-muted-foreground'>
            这首歌的独立页面已经建立。只有经过人工筛选、并且可以合法使用的日语、罗马音和中文文本才会加入站内。
          </p>
        </section>
      )
    }

    {
      details.sources?.length ? (
        <section class='mt-12 border-t pt-8' aria-labelledby='sources-heading'>
          <h2 id='sources-heading' class='m-0 text-lg font-medium text-foreground'>
            已筛选来源
          </h2>
          <div class='mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2'>
            {details.sources.map((source) => (
              <a
                href={source.url}
                target='_blank'
                rel='noopener noreferrer'
                class='group rounded-xl border bg-background/55 p-4 hover:border-[var(--primary)]/55'
              >
                <h3 class='m-0 text-sm font-medium text-foreground group-hover:text-[var(--primary)]'>
                  {source.label}
                </h3>
                <p class='mt-2 text-xs leading-5 text-muted-foreground'>{source.note}</p>
              </a>
            ))}
          </div>
        </section>
      ) : (
        <p class='mt-8 text-sm leading-6 text-muted-foreground'>中文翻译来源仍在筛选中。</p>
      )
    }
  </div>
</PageLayout>

<style>
  .lyric-sheet {
    max-width: 52rem;
  }

  .lyric-block + .lyric-block {
    margin-top: clamp(2.75rem, 7vw, 5rem);
  }

  .lyric-block p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .lyric-japanese,
  .lyric-chinese {
    color: hsl(var(--foreground));
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    line-height: 1.65;
    letter-spacing: 0.01em;
  }

  .lyric-romaji {
    margin-block: 0.55rem !important;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1.05rem, 2.1vw, 1.35rem);
    line-height: 1.65;
    letter-spacing: 0.015em;
  }

  @media (max-width: 639px) {
    .lyric-block + .lyric-block {
      margin-top: 2.75rem;
    }
  }
</style>
