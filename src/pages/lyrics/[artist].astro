---
import PageLayout from '@/layouts/CommonPage.astro'
import ArtistNav from '@/components/lyrics/ArtistNav.astro'

import { getArtist, getSongHref, lyricArtists } from '../../data/lyrics'

export function getStaticPaths() {
  return lyricArtists.map((artist) => ({ params: { artist: artist.slug } }))
}

const artist = getArtist(Astro.params.artist ?? '')
if (!artist) throw new Error(`Unknown lyric artist: ${Astro.params.artist}`)

const hasLyrics = (song: string) => Boolean(artist.details[song]?.lines.length)
---

<PageLayout title={artist.name} description={`按专辑和单曲浏览 ${artist.name} 的歌曲。`}>
  <ArtistNav slot='sidebar' artists={lyricArtists} currentSlug={artist.slug} />

  <div class='not-prose'>
    <div class='catalog'>
      <section class='catalog-section' aria-labelledby='albums-heading'>
        <div class='catalog-kind'>
          <h2 id='albums-heading'>专辑</h2>
        </div>

        <div class='catalog-list'>
          {
            artist.albums.map((album) => (
              <section class='catalog-row'>
                <h3>{album.title}</h3>
                <p class='song-links'>
                  {album.songs.map((song, songIndex) => (
                    <>
                      {songIndex > 0 && (
                        <span class='song-separator' aria-hidden='true'>
                          ・
                        </span>
                      )}
                      {hasLyrics(song) ? (
                        <a
                          href={getSongHref(artist, song)}
                          class='song-link has-lyrics'
                          data-astro-prefetch
                        >
                          {song}
                        </a>
                      ) : (
                        <span class='song-name'>{song}</span>
                      )}
                    </>
                  ))}
                </p>
              </section>
            ))
          }
        </div>
      </section>

      <section class='catalog-section' aria-labelledby='singles-heading'>
        <div class='catalog-kind'>
          <h2 id='singles-heading'>单曲</h2>
        </div>

        <div class='catalog-list'>
          <section class='catalog-row'>
            <h3>单曲</h3>
            <p class='song-links'>
              {
                artist.singles.map((song, songIndex) => (
                  <>
                    {songIndex > 0 && (
                      <span class='song-separator' aria-hidden='true'>
                        ・
                      </span>
                    )}
                    {hasLyrics(song) ? (
                      <a
                        href={getSongHref(artist, song)}
                        class='song-link has-lyrics'
                        data-astro-prefetch
                      >
                        {song}
                      </a>
                    ) : (
                      <span class='song-name'>{song}</span>
                    )}
                  </>
                ))
              }
            </p>
          </section>
        </div>
      </section>
    </div>
  </div>
</PageLayout>

<style>
  .catalog {
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 0.65rem;
    background: hsl(var(--background) / 0.46);
  }

  .catalog-section {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
  }

  .catalog-section + .catalog-section {
    border-top: 1px solid hsl(var(--border));
  }

  .catalog-kind {
    display: flex;
    align-items: center;
    padding: 1rem;
    border-inline-end: 1px solid hsl(var(--border));
    background: hsl(var(--muted) / 0.5);
  }

  .catalog-kind h2,
  .catalog-row h3,
  .song-links {
    margin: 0;
  }

  .catalog-kind h2 {
    font-size: 0.95rem;
    font-weight: 650;
    color: hsl(var(--foreground));
  }

  .catalog-row {
    display: grid;
    grid-template-columns: minmax(11.5rem, 25%) minmax(0, 1fr);
    align-items: stretch;
  }

  .catalog-row + .catalog-row {
    border-top: 1px solid hsl(var(--border));
  }

  .catalog-row h3 {
    display: flex;
    align-items: center;
    padding: 0.85rem 1rem;
    border-inline-end: 1px solid hsl(var(--border));
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.55;
    color: hsl(var(--foreground));
  }

  .song-links {
    padding: 0.68rem 1rem;
    font-size: 0.94rem;
    line-height: 2;
    overflow-wrap: anywhere;
  }

  .song-name {
    color: hsl(var(--foreground) / 0.82);
  }

  .song-link {
    text-decoration: none;
    text-underline-offset: 0.2em;
    transition: color 150ms ease;
  }

  .song-link.has-lyrics {
    color: hsl(var(--primary));
  }

  .song-link:hover {
    color: hsl(var(--primary));
    text-decoration: underline;
  }

  .song-separator {
    color: hsl(var(--muted-foreground) / 0.62);
  }

  @media (max-width: 767px) {
    .catalog-section {
      display: block;
    }

    .catalog-kind {
      padding: 0.7rem 0.9rem;
      border-inline-end: 0;
      border-bottom: 1px solid hsl(var(--border));
    }

    .catalog-row {
      display: block;
    }

    .catalog-row h3 {
      padding: 0.75rem 0.9rem 0.35rem;
      border-inline-end: 0;
    }

    .song-links {
      padding: 0.25rem 0.9rem 0.8rem;
      font-size: 0.91rem;
      line-height: 1.9;
    }
  }
</style>
