---
import PageLayout from '@/layouts/CommonPage.astro'

// 网站栏数据：后续要加新网站，往对应分类的 tools 数组里追加一项即可。
// description 不是必填——没写就不在卡片里显示描述行。
type Tool = {
  title: string
  href: string
  description?: string
}

type ToolGroup = {
  title: string
  tools: Tool[]
}

const groups: ToolGroup[] = [
  {
    title: '日语',
    tools: [
      {
        title: 'AyayaJp',
        href: 'https://ayaya114514.github.io/AyayaJp/',
        description: '单词语法练习'
      },
      {
        title: 'AyayaJpInput',
        href: 'https://ayaya114514.github.io/AyayaJpInput/',
        description: '日语输入法'
      },
      {
        title: 'AyayaJpType',
        href: 'https://ayaya114514.github.io/AyayaJpType/',
        description: '单词例句打字'
      }
    ]
  },
  {
    title: '工具',
    tools: [
      {
        title: 'AyayaMarkdown',
        href: 'https://ayaya114514.github.io/AyayaMarkdown/',
        description: '在线 Markdown 编辑器'
      },
      {
        title: 'AyayaVpsCalculator',
        href: 'https://ayaya114514.github.io/AyayaVpsCalculator/',
        description: 'VPS 剩余价值计算器'
      }
    ]
  },
  {
    title: '归档',
    tools: [
      {
        title: 'MiniDB',
        href: 'https://ayaya114514.github.io/MiniDB/',
        description: '浏览器内运行 SQL，查看查询计划与 B+ 树'
      },
      {
        title: 'AyayaGitSum',
        href: 'https://ayaya114514.github.io/AyayaGitSum/',
        description: '查看 GitHub 开发者概览'
      },
      {
        title: 'AyayaPrompt',
        href: 'https://ayaya114514.github.io/AyayaPrompt/',
        description: 'Prompt 管理、版本历史与模型调试'
      },
      {
        title: 'AyayaImage',
        href: 'https://ayaya114514.github.io/AyayaImage/',
        description: '批量处理图片，生成博客资源包'
      },
      {
        title: 'AyayaYaml',
        href: 'https://ayaya114514.github.io/AyayaYaml/',
        description: 'YAML 编辑与代理节点解析'
      },
      {
        title: 'AyayaMiner',
        href: 'https://ayaya114514.github.io/AyayaMiner/',
        description: '扫雷游戏'
      },
      {
        title: 'Ayaya Breach Protocol',
        href: 'https://ayaya114514.github.io/AyayaGame_1/',
        description: '规划路线与怪物编队的反向塔防游戏'
      },
      {
        title: 'AyayaUsage',
        href: 'https://ayaya114514.github.io/AyayaUsage/',
        description: '查看 Claude Code 花费、token 与额度用量'
      }
    ]
  }
]

const abbreviationOf = (title: string) => title.match(/[A-Z]/g)?.join('') ?? ''
---

<PageLayout title='网站' description='收集和分享我制作或常用的在线小工具。'>
  <nav slot='sidebar' aria-label='网站目录' class='text-sm'>
    <ul class='m-0 flex list-none flex-col gap-y-3 p-0'>
      {
        groups.map((group) => (
          <li class='tool-nav-group m-0' data-category={group.title}>
            <a
              href={`#${group.title}`}
              class='tool-nav-title block px-2 py-1 font-medium no-underline'
            >
              {group.title}
            </a>
            <ul class='m-0 ml-2 flex list-none flex-col gap-y-0.5 border-l border-border/70 p-0'>
              {group.tools.map((tool) => (
                <li class='m-0'>
                  <a
                    href={tool.href}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='block rounded-md px-2 py-1.5 pl-4 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground'
                  >
                    {tool.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class='tool-directory not-prose'>
    {
      groups.map((group) => (
        <section class='tool-section' data-category={group.title} aria-labelledby={group.title}>
          <div class='tool-section-heading'>
            <h2 id={group.title}>{group.title}</h2>
            <span class='tool-section-rule' aria-hidden='true' />
          </div>
          <div class='tool-grid'>
            {group.tools.map((t) => (
              <a href={t.href} target='_blank' rel='noopener noreferrer' class='tool-card'>
                <span class='tool-mark' aria-label={`${t.title} 缩写`}>
                  {abbreviationOf(t.title)}
                </span>
                <div class='tool-copy'>
                  <h3>{t.title}</h3>
                  {t.description && <p>{t.description}</p>}
                </div>
                <svg
                  class='tool-arrow'
                  width='14'
                  height='14'
                  viewBox='0 0 24 24'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='1.5'
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  aria-hidden='true'
                >
                  <path d='M7 17 17 7M7 7h10v10' />
                </svg>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</PageLayout>

<style>
  .tool-directory {
    display: grid;
    gap: 2rem;
  }

  .tool-section,
  .tool-nav-group {
    --tool-accent: 199 85% 78%;
  }

  [data-category='工具'] {
    --tool-accent: 158 55% 74%;
  }

  [data-category='归档'] {
    --tool-accent: 263 70% 82%;
  }

  .tool-nav-title {
    color: hsl(var(--tool-accent));
  }

  .tool-section-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }

  .tool-section-heading h2 {
    margin: 0;
    color: hsl(var(--tool-accent));
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
    scroll-margin-top: 6rem;
  }

  .tool-section-rule {
    height: 1px;
    flex: 1;
    margin-left: 0.375rem;
    background: linear-gradient(
      to right,
      hsl(var(--tool-accent) / 0.35),
      hsl(var(--tool-accent) / 0.05)
    );
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
    gap: 0.75rem;
  }

  .tool-card {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 0.875rem;
    align-items: start;
    gap: 0.75rem;
    min-height: 6.5rem;
    padding: 1.125rem;
    border: 1px solid hsl(var(--tool-accent) / 0.22);
    border-radius: 0.75rem;
    background: hsl(var(--background) / 0.55);
    text-align: left;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .tool-card:hover {
    border-color: hsl(var(--tool-accent) / 0.6);
    background: hsl(var(--muted) / 0.8);
  }

  .tool-card:focus-visible {
    outline: 2px solid hsl(var(--tool-accent));
    outline-offset: 3px;
  }

  .tool-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid hsl(var(--tool-accent) / 0.22);
    border-radius: 0.625rem;
    background: hsl(var(--tool-accent) / 0.08);
    color: hsl(var(--tool-accent));
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }

  .tool-copy {
    min-width: 0;
  }

  .tool-copy h3 {
    margin: 0;
    color: hsl(var(--foreground) / 0.96);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .tool-copy p {
    margin: 0.375rem 0 0;
    color: hsl(var(--muted-foreground) / 0.85);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .tool-arrow {
    margin-top: 0.25rem;
    color: hsl(var(--muted-foreground) / 0.45);
  }

  .tool-card:hover .tool-arrow {
    color: hsl(var(--tool-accent));
  }
</style>
