---
import PageLayout from '@/layouts/CommonPage.astro'

// 网站栏数据：后续要加新网站，往对应分类的 tools 数组里追加一项即可。
// description 不是必填——没写就不在卡片里显示描述行。
type Tool = {
  title: string
  href: string
  description?: string
}

type ToolGroup = {
  title: string
  tools: Tool[]
}

const groups: ToolGroup[] = [
  {
    title: '工具',
    tools: [
      {
        title: 'AyayaUsage',
        href: 'https://ayaya114514.github.io/AyayaUsage/',
        description: 'Claude Code 每日花费、token 与额度用量'
      },
      {
        title: 'AyayaMarkdown',
        href: 'https://ayaya114514.github.io/AyayaMarkdown/',
        description: '在线Markdown编辑器'
      },
      {
        title: 'AyayaVpsCalculator',
        href: 'https://ayaya114514.github.io/AyayaVpsCalculator/',
        description: 'VPS 剩余价值计算器'
      },
      {
        title: 'AyayaGitSum',
        href: 'https://ayaya114514.github.io/AyayaGitSum/',
        description: '简洁的 GitHub 开发者概览'
      },
      {
        title: 'AyayaPrompt',
        href: 'https://ayaya114514.github.io/AyayaPrompt/',
        description: '本地优先的 Prompt 管理、版本历史与模型 Playground'
      },
      {
        title: 'AyayaImage',
        href: 'https://ayaya114514.github.io/AyayaImage/',
        description: '本地批量图片预处理与博客资源包生成'
      },
      {
        title: 'AyayaYaml',
        href: 'https://ayaya114514.github.io/AyayaYaml/',
        description: '本地运行的 YAML 编辑与代理节点解析工具'
      },
      {
        title: 'MiniDB',
        href: 'https://ayaya114514.github.io/MiniDB/',
        description: '浏览器里运行的 Python 数据库：SQL、查询计划与 B+ 树可视化'
      }
    ]
  },
  {
    title: '游戏',
    tools: [
      {
        title: 'AyayaMiner',
        href: 'https://ayaya114514.github.io/AyayaMiner/',
        description: '扫雷游戏'
      },
      {
        title: 'Ayaya Breach Protocol',
        href: 'https://ayaya114514.github.io/AyayaGame_1/',
        description: '设计路线与怪物编队，突破自适应 AI 防线的反向塔防游戏'
      }
    ]
  },
  {
    title: '日语',
    tools: [
      {
        title: 'AyayaJp',
        href: 'https://ayaya114514.github.io/AyayaJp/',
        description: '日语练习'
      },
      {
        title: 'AyayaJpInput',
        href: 'https://ayaya114514.github.io/AyayaJpInput/',
        description: '浏览器里的日语输入法'
      }
    ]
  }
]

const total = groups.reduce((sum, group) => sum + group.tools.length, 0)

const abbreviationOf = (title: string) => title.match(/[A-Z]/g)?.join('') ?? ''
---

<PageLayout title='网站' description='收集和分享我制作或常用的在线小工具。'>
  <nav slot='sidebar' aria-label='网站目录' class='text-sm'>
    <ul class='m-0 flex list-none flex-col gap-y-3 p-0'>
      {
        groups.map((group) => (
          <li class='m-0'>
            <a
              href={`#${group.title}`}
              class='block px-2 py-1 font-medium text-foreground no-underline'
            >
              {group.title}
            </a>
            <ul class='m-0 flex list-none flex-col gap-y-1 p-0'>
              {group.tools.map((tool) => (
                <li class='m-0'>
                  <a
                    href={tool.href}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='block rounded-md px-2 py-1.5 pl-4 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground'
                  >
                    {tool.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </nav>

  <section>
    <p class='text-sm text-muted-foreground'>共 {total} 个</p>

    {
      groups.map((group) => (
        <div class='mt-6'>
          <h2 id={group.title} class='mb-0 mt-0 text-lg font-medium'>
            {group.title}
            <span class='ml-2 text-sm font-normal text-muted-foreground'>{group.tools.length}</span>
          </h2>
          <div class='not-prose mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3'>
            {group.tools.map((t) => (
              <a
                href={t.href}
                target='_blank'
                rel='noopener noreferrer'
                class='group flex flex-col gap-y-1.5 rounded-lg border bg-background/60 p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md'
              >
                <h3 class='flex flex-wrap items-center gap-x-2 gap-y-1 text-base font-medium leading-snug group-hover:text-primary'>
                  <span>{t.title}</span>
                  <span
                    class='inline-flex rounded border border-muted-foreground/35 px-1.5 py-0.5 text-xs font-semibold leading-none tracking-wide text-muted-foreground transition-colors group-hover:border-primary/50 group-hover:text-primary'
                    aria-label={`${t.title} 缩写`}
                  >
                    {abbreviationOf(t.title)}
                  </span>
                </h3>
                {t.description && <p class='text-sm text-muted-foreground'>{t.description}</p>}
                <p class='mt-auto truncate pt-1 text-xs text-muted-foreground/70'>{t.href}</p>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</PageLayout>
