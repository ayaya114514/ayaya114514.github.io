---
import type { LyricArtist } from '../../data/lyrics'

interface Props {
  artists: LyricArtist[]
  currentSlug?: string
}

const { artists, currentSlug } = Astro.props
---

<nav aria-label='歌词艺人' class='text-sm'>
  <ul class='m-0 flex list-none flex-col gap-y-1 p-0'>
    {
      artists.map((artist) => {
        const active = artist.slug === currentSlug

        return (
          <li class='m-0'>
            <a
              href={`/lyrics/${artist.slug}/`}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'block rounded-md px-2 py-1.5 transition-colors hover:bg-muted hover:text-foreground',
                active ? 'bg-muted text-[var(--primary)]' : 'text-muted-foreground'
              ]}
              data-astro-prefetch
            >
              {artist.name}
            </a>
          </li>
        )
      })
    }
  </ul>
</nav>
