---
import { isSectionActive, normalizeRoutePath } from '@/utils/blog-navigation'
import config from '@/site-config'

interface Props {
  showDesktop?: boolean
  hasSubNav?: boolean
}

const { showDesktop = true, hasSubNav = Astro.slots.has('nav-sub') } = Astro.props
const currentPath = normalizeRoutePath(Astro.url.pathname)
const sections = (config.header.menu ?? []).map((section) => ({
  ...section,
  active: isSectionActive(currentPath, section.link)
}))
---

<!-- ===== 桌面端侧边栏 ===== -->{
  showDesktop && hasSubNav && (
    <aside
      class='sticky top-20 hidden max-h-[calc(100vh-6rem)] w-56 shrink-0 self-start overflow-y-auto bg-transparent me-8 lg:block'
      aria-label='当前板块目录'
    >
      <slot name='nav-sub' />
    </aside>
  )
}

<!-- ===== 移动端：滑出抽屉（由 Header 的汉堡按钮触发） ===== -->
<div id='mobile-sidebar-root' class='lg:hidden'>
  <!-- 半透明遮罩 -->
  <div
    id='mobile-sidebar-backdrop'
    class='fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300'
    aria-hidden='true'
    hidden
  >
  </div>

  <!-- 抽屉面板 -->
  <div
    id='mobile-sidebar-drawer'
    class='fixed inset-y-0 start-0 z-50 flex w-72 max-w-[85vw] flex-col bg-background border-e border-border shadow-2xl -translate-x-full transition-transform duration-300 ease-out'
    role='dialog'
    aria-modal='true'
    aria-label='导航菜单'
    aria-hidden='true'
    inert
    hidden
  >
    <!-- 抽屉头部：标题 + 关闭按钮 -->
    <div class='flex items-center justify-between px-4 py-3 border-b border-border'>
      <span class='text-sm font-medium text-muted-foreground'>导航</span>
      <button
        id='mobile-sidebar-close'
        class='rounded-md p-1.5 transition-colors hover:bg-muted'
        aria-label='关闭侧边栏'
      >
        <svg class='h-4 w-4' viewBox='0 0 20 20' fill='currentColor' aria-hidden='true'>
          <path
            d='M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 0 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 0 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z'
          ></path>
        </svg>
      </button>
    </div>

    <!-- 抽屉内容：与桌面侧边栏相同的导航 + 当前板块子栏目 -->
    <nav class='flex-1 overflow-y-auto px-3 py-4' aria-label='移动侧栏导航'>
      {
        sections.map((s) => {
          const { active } = s
          return (
            <div class='flex flex-col'>
              <a
                href={s.link}
                aria-current={active ? 'page' : undefined}
                class={`w-full px-3 py-2.5 rounded-md text-sm font-medium transition-colors hover:bg-muted ${
                  active ? 'bg-muted text-[var(--primary)]' : 'text-muted-foreground'
                }`}
              >
                {s.title}
              </a>

              {active && hasSubNav && (
                <div class='mt-1 mb-2 ms-3 ps-3 border-l border-muted-foreground/20'>
                  <slot name='nav-sub' />
                </div>
              )}
            </div>
          )
        })
      }
    </nav>
  </div>
</div>

<script>
  function initMobileSidebar() {
    const close = document.getElementById('mobile-sidebar-close')
    const backdrop = document.getElementById('mobile-sidebar-backdrop')
    const drawer = document.getElementById('mobile-sidebar-drawer')
    const root = document.getElementById('mobile-sidebar-root')
    const toggle = document.getElementById('toggleMenu')

    if (!close || !backdrop || !drawer || !root || !toggle) return
    const closeButton = close
    const backdropEl = backdrop
    const drawerEl = drawer
    const rootEl = root
    const toggleButton = toggle
    const desktopMedia = window.matchMedia('(min-width: 1024px)')
    const inertSiblings: HTMLElement[] = []
    let lastFocused: HTMLElement | null = null
    let hideTimer: number | undefined

    const focusableSelector =
      'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'

    function setBackgroundInert(value: boolean) {
      if (value) {
        inertSiblings.length = 0
        const candidates = new Set<HTMLElement>()
        for (const sibling of Array.from(rootEl.parentElement?.children ?? [])) {
          if (sibling instanceof HTMLElement) candidates.add(sibling)
        }
        const mainContainer = document.getElementById('main-container')
        for (const child of Array.from(mainContainer?.children ?? [])) {
          if (child instanceof HTMLElement && !child.contains(rootEl)) candidates.add(child)
        }
        for (const candidate of candidates) {
          if (candidate === rootEl || candidate.inert) continue
          candidate.inert = true
          inertSiblings.push(candidate)
        }
        return
      }
      for (const sibling of inertSiblings) sibling.inert = false
      inertSiblings.length = 0
    }

    function open() {
      if (desktopMedia.matches) return
      if (hideTimer) {
        window.clearTimeout(hideTimer)
        hideTimer = undefined
      }
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null
      backdropEl.hidden = false
      drawerEl.hidden = false
      drawerEl.removeAttribute('inert')
      drawerEl.setAttribute('aria-hidden', 'false')
      toggleButton.setAttribute('aria-expanded', 'true')
      setBackgroundInert(true)
      document.body.style.overflow = 'hidden'
      requestAnimationFrame(() => {
        drawerEl.classList.remove('-translate-x-full')
        backdropEl.classList.remove('opacity-0', 'pointer-events-none')
        closeButton.focus()
      })
    }

    function close_(restoreFocus = true, hideImmediately = false) {
      if (hideTimer) {
        window.clearTimeout(hideTimer)
        hideTimer = undefined
      }
      drawerEl.setAttribute('inert', '')
      drawerEl.setAttribute('aria-hidden', 'true')
      drawerEl.classList.add('-translate-x-full')
      backdropEl.classList.add('opacity-0', 'pointer-events-none')
      toggleButton.setAttribute('aria-expanded', 'false')
      setBackgroundInert(false)
      document.body.style.overflow = ''
      if (restoreFocus) lastFocused?.focus()
      else if (drawerEl.contains(document.activeElement)) {
        ;(document.activeElement as HTMLElement).blur()
      }
      lastFocused = null

      if (hideImmediately) {
        drawerEl.hidden = true
        backdropEl.hidden = true
        return
      }
      hideTimer = window.setTimeout(() => {
        if (drawerEl.getAttribute('aria-hidden') === 'true') {
          drawerEl.hidden = true
          backdropEl.hidden = true
        }
        hideTimer = undefined
      }, 300)
    }

    function handleDesktopBreakpoint(event: MediaQueryListEvent) {
      // The mobile root becomes display:none at lg. Release the modal state at
      // the same breakpoint so inert siblings and the body scroll lock cannot linger.
      if (event.matches && drawerEl.getAttribute('aria-hidden') === 'false') close_(false, true)
    }

    // 暴露给 Header 的汉堡按钮调用
    window.__openMobileSidebar = open

    closeButton.addEventListener('click', () => close_())
    backdropEl.addEventListener('click', () => close_())
    drawerEl.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => close_(false))
    })
    desktopMedia.addEventListener('change', handleDesktopBreakpoint)

    // 按 Escape 关闭；Tab / Shift+Tab 始终限制在 modal drawer 内。
    document.addEventListener('keydown', (e) => {
      if (drawerEl.classList.contains('-translate-x-full')) return
      if (e.key === 'Escape') {
        close_()
        return
      }
      if (e.key !== 'Tab') return

      const focusable = Array.from(drawerEl.querySelectorAll<HTMLElement>(focusableSelector))
      if (focusable.length === 0) return
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault()
        last.focus()
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault()
        first.focus()
      }
    })
  }

  initMobileSidebar()
</script>
